# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (rag.py โหลดผ่าน python-dotenv อัตโนมัติ)
#   cp .env.example .env

# LLM endpoint แบบ OpenAI-compatible + API key
LLM_BASE_URL=http://your-llm-endpoint/v1
#
# 🔐 LLM_API_KEY — เครื่องที่พัฒนาอยู่ "จงใจ" ปล่อยบรรทัดนี้ว่างไว้ แล้วเก็บค่าจริงเป็น
#    env var ของระบบปฏิบัติการแทน เพื่อไม่ให้ความลับอยู่ในไฟล์เลย
#      Windows: setx LLM_API_KEY "<คีย์>"   (แล้วเปิด terminal ใหม่)
#      Linux  : export LLM_API_KEY="<คีย์>" (ใส่ใน ~/.bashrc หรือ systemd unit)
#    ⚠️ ถ้าจะเติมลงไฟล์นี้แทนก็ได้ แต่ต้องแน่ใจว่า .env ไม่ถูก commit (gitignore กันไว้แล้ว)
#    ⚠️ docker compose ส่งต่อค่านี้จาก env ของเครื่องให้เอง และจะหยุดพร้อมบอกวิธีแก้
#       ถ้ายังไม่ได้ตั้ง — เคยพลาดตรงนี้แล้ว container ตายด้วยข้อความ
#       "openai.OpenAIError: Missing credentials" ซึ่งอ่านแล้วไม่รู้ว่าต้องไปแก้ที่ไหน
LLM_API_KEY=

# (ออปชัน) Ollama endpoint — ใช้เฉพาะตอนสลับ EMBED_MODEL เป็น paraphrase-multilingual
OLLAMA_BASE_URL=http://localhost:11434

# (ออปชัน) experiment tracking — ไม่ตั้ง = เก็บลง mlruns/ ในเครื่อง
# MLFLOW_TRACKING_URI=http://your-mlflow-server:5000/
# MLFLOW_EXPERIMENT=thai-law-rag-eval
#
# 🔐 ถ้า MLflow server ต้อง login: ตั้ง MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD
#    เป็น env var ของ "ระบบปฏิบัติการ" — อย่าใส่ในไฟล์ .env เพราะเสี่ยงหลุดเข้า repo
#    Windows: setx MLFLOW_TRACKING_USERNAME "ชื่อผู้ใช้"    (ปิด-เปิด terminal ใหม่)

# ═══ FastAPI (main.py) ═══
# 🔐 จำเป็น — ไม่ตั้งแล้ว API จะ "สตาร์ทไม่ขึ้น" (จงใจ เพราะลืมตั้งครั้งเดียว = เปิดโล่ง)
API_KEY=ตั้งค่าสุ่มยาว ๆ
#
# ยอมเปิดโดยไม่มีคีย์ (เฉพาะเครื่องตัวเอง ห้ามใช้กับเครื่องที่คนอื่นเข้าถึงได้)
# ALLOW_NO_AUTH=1
#
# โดเมนที่อนุญาตให้เว็บเรียกข้าม origin ได้ — ไม่ตั้ง = ไม่เปิดให้เว็บอื่นเลย (ปลอดภัยกว่า)
# เรียกจาก server/CLI/curl ไม่ต้องตั้งอันนี้
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
#
# ปิดหน้า /docs (ตั้ง 0 เมื่อเปิดออกอินเทอร์เน็ตจริง)
# API_DOCS=0

# ═══ OCR ของบริษัท — ใช้เฉพาะตอนรัน eval/ocr_bench.py --engine company ═══
# ระบบหลักยังใช้ EasyOCR (local) อยู่ ไม่ตั้ง 2 ตัวนี้ก็ใช้งานได้ตามปกติ
# OCR_BASE_URL=https://<host ภายใน>:<port>        # ไม่ต้องมี /v3 ต่อท้าย โค้ดเติมเอง
# OCR_API_KEY=<คีย์ที่ได้จากทีมที่ดูแล service>    # service รับ Bearer token เท่านั้น
#
# (ออปชัน) ปรับได้ ถ้าไม่ตั้งจะใช้ค่าในวงเล็บ
# OCR_MODEL_NAME=qwen/qwen3.5-27b     # โมเดลอ่านภาพ
# OCR_PRE_ENGINE=tesseract            # เครื่อง pre-OCR
# OCR_VERIFY_SSL=1                    # (ค่าเริ่มต้น=ปิด เพราะ service ภายในใช้ self-signed cert)
# OCR_MAX_WAIT_SEC=7200               # รอผลนานสุดกี่วินาที
# OCR_PROMPT=...                      # ทับ prompt เริ่มต้น
#   ⚠️ prompt เริ่มต้นจงใจสั่ง "ห้ามแก้คำผิดตามบริบท" ต่างจาก prompt ต้นฉบับของบริษัท
#      เพราะกับตัวบทกฎหมาย ถ้าโมเดลเดาแทนเรา มันอาจเปลี่ยน "๕ ปี" เป็น "๑๐ ปี"
#      แล้วออกมาอ่านลื่นจนไม่มีอะไรส่อว่าผิด — ดูเหตุผลเต็มใน eval/ocr_bench.py

# รอ LLM ตอบนานสุดกี่วินาทีต่อ 1 คำขอ (ค่าเริ่มต้นในโค้ด 600 — สูงเกินไปสำหรับงานจริง)
#   openai client ลองซ้ำเองอีก 2 ครั้ง -> เวลาที่แย่ที่สุด = ค่านี้ x 3
#   ตั้ง 120 = แย่สุด 6 นาที · ตั้ง 600 = แย่สุด 30 นาที ซึ่งกินคิวทั้งที่ผู้เรียกเลิกรอไปแล้ว
LLM_TIMEOUT=120

# (ออปชัน) override ค่าอื่น
# LLM_MODEL=google/gemma-4-26b-a4b-it
# EMBED_MODEL=text-embedding-ada-002
# RAG_RERANK=0                          # ปิด cross-encoder reranker (เร็วขึ้น แม่นลง)
# TOP_K=12                              # จำนวน chunk ที่ส่งให้ LLM ตอบ
# RAG_TRACE=1                           # MLflow Tracing: บันทึกเส้นทางหาคำตอบทุกขั้น
#   (ขยายคำถาม→ค้น→rerank→ตอบ) ดูที่ MLflow UI แท็บ Traces — ปิดไว้ = ไม่มี overhead

# ═══ ตัวแปรขั้นสูง — ปกติไม่ต้องแตะ แต่มีอยู่จริงในโค้ด ═══
# ไล่เก็บมาจาก os.environ.get ทั้งหมด เพราะของที่ "มีแต่ไม่มีใครรู้ว่ามี" = เท่ากับไม่มี
#
# แก้จูนการค้น (เปลี่ยนแล้วควรรัน eval/run_eval.py ซ้ำ ตัวเลขจะขยับ)
# RAG_DEDUPE=0            # เลิกยุบมาตราซ้ำข้ามฉบับ (ค่าเริ่มต้นเปิด)
# RAG_ART_BOOST=0         # เลิกดัน "มาตราที่ถามตรง ๆ" ขึ้นอันดับ 1
# RAG_SCAN_DEMOTE=0       # เลิกดัน chunk จาก OCR ไปท้ายแถว
# RERANK_TOP_N=50         # ส่งกี่ก้อนให้ reranker ก่อนตัดเหลือ TOP_K
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# LAW_SAME_RATIO=...      # เกณฑ์ตัดสินว่าตัวบทสองรุ่น "เนื้อหาเดียวกัน" ไหม
# CHUNK_SIZE / CHUNK_OVERLAP  (1500 / 250) — เปลี่ยนแล้วต้อง rebuild index ใหม่ทั้งชุด
#
# ที่เก็บดัชนี (เปลี่ยนแล้วต้อง rebuild)
# CHROMA_DIR=chroma_db
# COLLECTION_NAME=...
#
# อื่น ๆ
# RAG_DEBUG=1             # พิมพ์รายละเอียดตอนค้น/rerank — ใช้ตอนไล่หาสาเหตุ
# RAG_STREAM=0            # ปิด streaming ตอนรันโหมด CLI (python rag.py)
# OCR_MIN_CHARS=...       # หน้าที่คัดข้อความได้น้อยกว่านี้ ถือว่าเป็นหน้าสแกน -> ส่งเข้า OCR
# PUBLISH_STAMP_YEAR=...  # ปีที่ปรากฏบนหัวเอกสารทุกฉบับ กันอ่านผิดว่าเป็นคำขอย้อนเวลา
# OCR_USERNAME / OCR_PASSWORD / OCR_POLL_SEC   # เฉพาะ eval/ocr_bench.py --engine company
# LOAD_TEST_BASE=http://127.0.0.1:8000         # เฉพาะ eval/load_test.py
# ABL_RERANK / ABL_RAW / ABL_FILE              # เฉพาะ experiments/hybrid_ablation.py
